RPG_Station_Anvil.name = Bigorna
RPG_Station_Anvil.description = Uma estação de trabalho que tempera barras e melhora armas. Pressione usar para começar a trabalhar.
RPG_Station_Anvil.hint.empty = Pressione [{key}] para colocar uma barra ou arma
RPG_Station_Anvil.hint.loaded = Pressione [{key}] para trabalhar
