RPG_Station_Anvil.name = Anvil
RPG_Station_Anvil.description = A work station that forges bars and enhances weapons. Press use to start working.
RPG_Station_Anvil.hint.empty = Press [{key}] to place a bar or weapon
RPG_Station_Anvil.hint.loaded = Press [{key}] to work
