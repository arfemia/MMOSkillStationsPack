RPG_Station_Anvil.name = Enclume
RPG_Station_Anvil.description = Une station de travail qui forge des barres et améliore les armes. Appuie sur utiliser pour commencer à travailler.
RPG_Station_Anvil.hint.empty = Appuie sur [{key}] pour placer une barre ou une arme
RPG_Station_Anvil.hint.loaded = Appuie sur [{key}] pour travailler
