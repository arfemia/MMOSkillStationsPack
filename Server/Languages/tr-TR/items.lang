RPG_Station_Anvil.name = Örs
RPG_Station_Anvil.description = Çubukları döve ve silahları geliştiren bir çalışma istasyonu. Çalışmaya başlamak için kullan tuşuna bas.
RPG_Station_Anvil.hint.empty = Bir çubuk veya silah yerleştirmek için [{key}] tuşuna bas
RPG_Station_Anvil.hint.loaded = Çalışmak için [{key}] tuşuna bas
