RPG_Station_Anvil.name = Incudine
RPG_Station_Anvil.description = Una stazione di lavoro che forgia barre e migliora le armi. Premi usa per iniziare a lavorare.
RPG_Station_Anvil.hint.empty = Premi [{key}] per posizionare una barra o un'arma
RPG_Station_Anvil.hint.loaded = Premi [{key}] per lavorare
