RPG_Station_Anvil.name = Amboss
RPG_Station_Anvil.description = Eine Arbeitsstation, die Barren schmiedet und Waffen verbessert. Drücke die Benutzen-Taste, um zu arbeiten.
RPG_Station_Anvil.hint.empty = Drücke [{key}] zum Einlagern eines Barren oder einer Waffe
RPG_Station_Anvil.hint.loaded = Drücke [{key}] zum Arbeiten
